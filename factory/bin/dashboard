# Section order and membership
_GROUPS = [
    ("you", "Needs you"),
    ("author", "Waiting on the author"),
    ("moving", "Moving"),
    ("done", "Done"),
    ("error", "Unreadable"),
]
_EXIT_LABEL = {"needs-human": ("Needs you", "x-you"),
               "needs-info": ("Waiting on author", "x-wait"),
               "rejected": ("Rejected", "x-fail")}
_VERDICT = {"PASS": ("Pass", "v-pass"), "CHANGES": ("Changes", "v-fail"),
            "pending": ("Pending", "v-wait"), "missing": ("Missing", "v-muted"),
            "invalid": ("Invalid", "v-fail")}
_BUCKET = {"pass": ("Pass", "check-pass"), "fail": ("Fail", "check-fail"),
           "cancel": ("Cancelled", "check-fail"), "pending": ("Pending", "check-pending"),
           "skipping": ("Skipped", "check-skip")}


def _group(v: dict) -> str:
    if v.get("error"):
        return "error"
    if (v.get("stage") or "") in DONE:
        return "done"
    if v.get("needs") == "you":
        return "you"
    if v.get("needs") == "author":
        return "author"
    return "moving"


def _fmt_now(now: str) -> str:
    try:
        t = datetime.strptime(now, "%Y-%m-%dT%H:%M:%SZ")
        return t.strftime("%H:%M UTC")
    except (TypeError, ValueError):
        return now or ""


def render(views: list[dict], now: str, refresh: int | None, all_reviewers=()) -> str:
    """Render a self-contained HTML dashboard page."""
    E = _html.escape
    groups = {key: [] for key, _ in _GROUPS}
    for v in views:
        groups[_group(v)].append(v)

    parts = ['<!DOCTYPE html><html lang="en"><head>', '<meta charset="UTF-8">',
             '<meta name="viewport" content="width=device-width, initial-scale=1">']
    if refresh is not None:
        parts.append(f'<meta http-equiv="refresh" content="{refresh}">')
    parts.append("<title>Tiny Software Factory dashboard</title>")
    parts.append(f"<style>{_STYLE}</style>")
    parts.append("</head><body><main>")
    parts.append("<header><h1>Tiny Software Factory</h1>")
    parts.append('<ul class="counts">')
    for key, cls, label in (("you", "c-you", "needs you"), ("moving", "", "moving"),
                            ("author", "c-wait", "waiting on author"), ("done", "", "done")):
        n = len(groups[key])
        c = f' class="{cls}"' if cls and n else ""
        parts.append(f"<li{c}><b>{n}</b>{label}</li>")
    parts.append("</ul></header>")

    if not views:
        parts.append('<p class="empty">No jobs yet</p>')
    for key, heading in _GROUPS:
        if not groups[key]:
            continue
        cls = ' class="moving"' if key == "moving" else ""
        parts.append(f'<section{cls}><h2>{heading}</h2>')
        for v in groups[key]:
            parts.append(_render_card(v, now, E, all_reviewers))
        parts.append("</section>")

    parts.append(f'<footer>Updated <time datetime="{E(now)}">{E(_fmt_now(now))}</time></footer>')
    parts.append("</main></body></html>")
    return "\n".join(parts)


def _render_line(timeline: list[dict], E) -> str:
    out = ['<ol class="line" aria-label="Stages">']
    for t in timeline:
        stage = t.get("stage") or ""
        state = t.get("state") or "todo"
        at = t.get("at") or ""
        title = f' title="{E(at)}"' if at else ""
        if state == "exit":
            label, xcls = _EXIT_LABEL.get(stage, (stage, "x-fail"))
            out.append(f'<li class="st st-exit {xcls}"{title}>{E(label)}</li>')
        elif state == "current" and stage == "merged":
            out.append(f'<li class="st st-merged"{title}>{E(stage)}</li>')
        elif state == "current":
            out.append(f'<li class="st st-current"{title} aria-current="step">'
                       f'<span class="pulse" aria-hidden="true"></span>{E(stage)}</li>')
        elif state == "done":
            out.append(f'<li class="st st-done"{title}>{E(stage)}</li>')
        else:
            out.append(f'<li class="st st-todo">{E(stage)}</li>')
    out.append("</ol>")
    return "".join(out)


def _render_card(v: dict, now: str, E, all_reviewers) -> str:
    out = []
    if v.get("error"):
        eid = E(v.get("id") or "unknown")
        err = E(v.get("error") or "unreadable")
        out.append(f'<article class="job error"><h3 class="mono">{eid}</h3>'
                   f'<p class="meta">skipped: unreadable ({err})</p></article>')
        return "\n".join(out)

    title = E(v.get("title") or v.get("id") or "")
    rnd = v.get("round") or 0
    rlim = v.get("round_limit") or 3

    needs = v.get("needs")
    ncls = " needs-you" if needs == "you" else " needs-wait" if needs == "author" else ""
    out.append(f'<article class="job{ncls}">')

    # Row 1: issue + title, meta on the right
    out.append('<div class="head"><h3>')
    issue_num = v.get("issue")
    issue_url = _safe_href(v.get("issue_url"))
    inner = ""
    if issue_num:
        inner += f'<span class="issue num">#{E(str(issue_num))}</span>'
    inner += title
    out.append(f'<a href="{issue_url}">{inner}</a>' if issue_url else inner)
    out.append('</h3><p class="meta">')
    job_id = v.get("id")
    if job_id:
        out.append(f'<span class="mono">{E(str(job_id))}</span>')
    pr_url = _safe_href(v.get("pr_url"))
    if v.get("pr"):
        pr_txt = f"PR #{E(str(v.get('pr')))}"
        out.append(f'<a href="{pr_url}">{pr_txt}</a>' if pr_url else f"<span>{pr_txt}</span>")
    if rnd:
        out.append(f'<span class="num">round {rnd} of {rlim}</span>')
    elapsed = _fmt_elapsed(v.get("started"), v.get("ended"), now)
    if elapsed:
        out.append(f'<span class="num" title="Elapsed">{E(elapsed)}</span>')
    out.append("</p></div>")

    # Row 2: the line
    timeline = v.get("timeline") or []
    if timeline:
        out.append(_render_line(timeline, E))

    # Row 3: reviews and checks
    rounds = v.get("rounds") or []
    required = v.get("required") or []
    current_round = next((r for r in rounds if r.get("current")), None)
    status = []
    if current_round or required:
        reviews = (current_round or {}).get("reviews") or {}
        reviews_passed = sum(1 for rv in reviews.values() if rv == "PASS")
        status.append(f'<div class="reviews"><h4>Reviews <span class="num">'
                      f'{reviews_passed} of {len(required)} passed</span></h4>')
        if required:
            status.append("<ul>")
            for reviewer in required:
                if current_round:
                    word, vcls = _VERDICT.get(reviews.get(reviewer, "pending"), ("Invalid", "v-fail"))
                else:  # review of this round has not started yet
                    word, vcls = "Not started", "v-muted"
                status.append(f'<li><span class="mono">{E(reviewer)}</span>'
                              f'<span class="{vcls}">{word}</span></li>')
            status.append("</ul>")
        not_req = [r for r in all_reviewers if r not in required]
        if not_req:
            status.append('<p class="quiet">Not required: ' + ", ".join(E(r) for r in not_req) + "</p>")
        previous = []
        for prior in rounds:
            if not prior.get("current"):
                items = ", ".join(f"{E(n)} {_VERDICT.get(rv, (E(rv),))[0]}"
                                  for n, rv in (prior.get("reviews") or {}).items())
                previous.append(f'Round {E(str(prior["n"]))}: {items}')
        if previous and v.get("stage") in {"build", "review"}:
            status.append(f'<p class="quiet">Previous review, {previous.pop()}</p>')
        if previous:
            status.append("<details><summary>Earlier rounds</summary><ul>")
            status.extend(f"<li>{item}</li>" for item in previous)
            status.append("</ul></details>")
        status.append("</div>")

    checks_data = v.get("checks")
    if "checks" not in v and v.get("pr"):
        status.append('<div class="checks checks-na"><h4>Checks not fetched (--no-gh)</h4></div>')
    elif checks_data is None:
        status.append('<div class="checks checks-na"><h4>No PR yet</h4></div>')
    elif not checks_data.get("ok"):
        status.append('<div class="checks checks-na"><h4>Checks unavailable</h4></div>')
    else:
        checks_passed = checks_data.get("passed", 0)
        total = checks_data.get("total", 0)
        check_items = checks_data.get("checks") or []
        skipped = sum(c.get("bucket") == "skipping" for c in check_items)
        if any(c.get("bucket") in ("fail", "cancel") for c in check_items):
            summary_cls = "checks-fail"
        elif any(c.get("bucket") == "pending" for c in check_items):
            summary_cls = "checks-pending"
        else:
            summary_cls = "checks-ok"
        if not check_items:
            status.append('<div class="checks checks-na"><h4>No checks</h4>')
        else:
            count = f"{checks_passed} of {total} passed" if total else "None counted"
            if skipped:
                count += f", {skipped} skipped"
            status.append(f'<div class="checks {summary_cls}"><h4>Checks <span class="num">'
                          f'{count}</span></h4>')
        if check_items:
            status.append("<ul>")
            for c in check_items:
                cname = E(c.get("name") or "")
                link = _safe_href(c.get("link"))
                entry = (f'<a class="mono" href="{link}">{cname}</a>' if link
                         else f'<span class="mono">{cname}</span>')
                word, bcls = _BUCKET.get(c.get("bucket") or "", (E(c.get("bucket") or "Unknown"), "check-skip"))
                status.append(f'<li>{entry}<span class="{bcls}">{word}</span></li>')
            status.append("</ul>")
        status.append("</div>")
    if status:
        out.append('<div class="status">' + "".join(status) + "</div>")

    # Row 4: note, heading markers stripped
    note = v.get("note")
    if note:
        stripped = [line.lstrip("# ") if line.startswith("#") else line for line in note.splitlines()]
        ncls = {"you": "n-you", "author": "n-wait"}.get(v.get("needs") or "",
                                                       "n-fail" if v.get("stage") == "rejected" else "")
        out.append(f'<div class="note {ncls}">{E(chr(10).join(stripped))}</div>')

    out.append("</article>")
    return "\n".join(out)


REPO = Path(__file__).resolve().parents[2]
JOBS = REPO / "factory" / "jobs"
CONFIG_PATH = REPO / "factory" / "config.json"
DEFAULT_OUT = REPO / "factory" / "dashboard.html"


def _load_reviewers(config_path: Path):
    """Return the union of all reviewer lists in config.json, in order."""
    try:
        data = json.loads(config_path.read_text())
        seen = []
        for lst in data.get("reviewers", {}).values():
            for r in lst:
                if r not in seen:
                    seen.append(r)
        return tuple(seen)
    except Exception:
        return ()


def main(argv):
    """CLI entry point. Read-only: never writes under factory/jobs."""
    parser = argparse.ArgumentParser(
        prog="factory/bin/dashboard",
        description=(
            "Render a read-only HTML dashboard of the tiny software factory. "
            "Never writes under factory/jobs."
        ),
    )
    parser.add_argument(
        "--out", type=Path, default=None,
        help="Output HTML file (default: factory/dashboard.html)",
    )
    parser.add_argument(
        "--watch", nargs="?", const=5, type=int, metavar="SECS",
        help="Refresh every SECS seconds (default 5). Must be >= 1.",
    )
    parser.add_argument(
        "--no-gh", action="store_true",
        help="Skip GitHub PR checks (no gh CLI calls).",
    )
    parser.add_argument(
        "--open", action="store_true",
        help="Open the dashboard in the default browser after the first write.",
    )
    args = parser.parse_args(argv)

    if args.watch is not None and args.watch < 1:
        parser.error("--watch SECS must be >= 1")

    out = args.out if args.out is not None else DEFAULT_OUT
    destination = out.parent.resolve() / out.name
    jobs_dir = JOBS.resolve()
    if destination.is_relative_to(jobs_dir) or out.resolve().is_relative_to(jobs_dir):
        parser.error("--out must not point inside factory/jobs")
    destination.parent.mkdir(parents=True, exist_ok=True)

    all_reviewers = _load_reviewers(CONFIG_PATH)
    finished_checks = {}

    def _write_once():
        views = read_jobs(JOBS)
        now = datetime.now(tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        for v in views:
            if v.get("error"):
                continue
            pr = v.get("pr")
            if not pr:
                v["checks"] = None
            elif not args.no_gh:
                if v.get("stage") in DONE:
                    expires, result = finished_checks.get(pr, (0, None))
                    if time.monotonic() >= expires:
                        result = pr_checks(pr)
                        finished_checks[pr] = (time.monotonic() + 60, result)
                    v["checks"] = result
                else:
                    v["checks"] = pr_checks(pr)
        html = render(views, now, args.watch, all_reviewers)
        with tempfile.NamedTemporaryFile(dir=destination.parent, encoding="utf-8",
                                         mode="w", delete=False) as handle:
            tmp = Path(handle.name)
            try:
                handle.write(html)
                handle.close()
                tmp.replace(destination)
            finally:
                tmp.unlink(missing_ok=True)

    _write_once()
    print(out)

    if args.open:
        webbrowser.open(out.resolve().as_uri())

    if args.watch is not None:
        try:
            while True:
                time.sleep(args.watch)
                try:
                    _write_once()
                except Exception as exc:  # keep watching after one bad tick
                    print(f"dashboard: render failed: {exc!r}", file=sys.stderr)
        except KeyboardInterrupt:
            pass


if __name__ == "__main__":
    main(sys.argv[1:])
