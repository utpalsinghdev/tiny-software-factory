#!/usr/bin/env python3
"""Read-only HTML dashboard for the tiny software factory.

Reads the job folders that factory/bin/job writes under factory/jobs, asks
`gh pr checks` for linked PRs, and writes one self-contained HTML page
(no JavaScript). It never writes under factory/jobs.

Usage:
  factory/bin/dashboard                  write factory/dashboard.html once
  factory/bin/dashboard --watch --open   refresh every 5 s and open it
  factory/bin/dashboard --no-gh --out F  skip gh, write to F
"""
import argparse
import html as _html
import json
import re
import subprocess
import sys
import tempfile
import time
import webbrowser
from datetime import datetime, timezone
from pathlib import Path

# Stage constants, as in bin/job
DONE = {"merged", "rejected"}
WAITING = {"needs-info", "needs-human"}

# Ordered pipeline stages shown in the timeline (exit stages handled separately)
PIPELINE = ["intake", "spec", "build", "review", "approve", "merged"]

# File that proves each pipeline stage is reached (for mtime / "at")
# review uses the round folder; merged uses decision.md
_STAGE_FILE = {
    "intake": "intake.md",
    "spec": "spec.md",
    "build": "build.md",
    "review": None,  # handled specially: first reviewer file
    "approve": "decision.md",
    "merged": "decision.md",
}

# Verdict on the first line, exactly as bin/job sync() checks it
_VERDICT_RE = re.compile(r"VERDICT:\s*(PASS|CHANGES)")
# Stages where the current round's reviewers are actually reviewing
_REVIEWING = {"review", "approve", "merging", "merged"}


def _iso_mtime(path: Path) -> str | None:
    """Return ISO-8601 UTC mtime of path, or None if it doesn't exist."""
    if not path.exists():
        return None
    ts = path.stat().st_mtime
    return datetime.fromtimestamp(ts, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _body(path: Path) -> str | None:
    """Body after the first blank line (same as bin/job body()). None if missing."""
    try:
        return path.read_text().split("\n\n", 1)[-1].strip()
    except (OSError, UnicodeDecodeError):
        return None


def _read_verdict(path: Path) -> str:
    """Return PASS/CHANGES from first line, or 'invalid' if unreadable/no match."""
    try:
        first = path.read_text().split("\n", 1)[0].strip()
        m = _VERDICT_RE.fullmatch(first)
        return m.group(1) if m else "invalid"
    except (OSError, UnicodeDecodeError):
        return "invalid"


def _build_rounds(job_dir: Path, job: dict) -> list[dict]:
    """Build the rounds list from round-N/ subdirectories."""
    current_round = job.get("round", 0)
    reviewers = job.get("reviewers", [])
    reviewing = job.get("stage") in _REVIEWING

    # bin/job creates round-N/ when build starts, so an empty folder is not
    # a review. Show a round only once it has a reviewer file, or when it is
    # the current round and the job is in review or later.
    rounds = []
    for n in range(1, current_round + 1):
        is_current = (n == current_round)
        rd = job_dir / f"round-{n}"
        if not any(rd.glob("*.md")) and not (is_current and reviewing):
            continue
        reviews = {}
        for reviewer in reviewers:
            rfile = rd / f"{reviewer}.md"
            if rfile.exists():
                reviews[reviewer] = _read_verdict(rfile)
            elif is_current:
                reviews[reviewer] = "pending"
            else:
                reviews[reviewer] = "missing"
        rounds.append({"n": n, "reviews": reviews, "current": is_current})
    return rounds


def _last_pipeline_stage(job_dir: Path, job: dict) -> str:
    """Infer the last pipeline stage reached by checking which files exist.

    Used when the current stage is an exit stage (not in PIPELINE) so
    job.json does not record the previous stage.
    """
    # decision.md is also the needs-human reason, so it cannot prove approve.
    # Review is reached only with a reviewer file or a PR (set by build->review).
    if _review_files(job_dir) or job.get("pr"):
        return "review"
    for ps in ("build", "spec"):
        if (job_dir / f"{ps}.md").exists():
            return ps
    return "intake"


def _review_files(job_dir: Path) -> list[Path]:
    """Reviewer files in any round folder, oldest first."""
    files = [p for p in job_dir.glob("round-*/*.md") if p.is_file()]
    return sorted(files, key=lambda p: p.stat().st_mtime)


def _build_timeline(job_dir: Path, job: dict) -> list[dict]:
    """Build the timeline list."""
    stage = job.get("stage", "intake")
    # merging: approve is done, merged is the current station
    merging = stage == "merging"
    if merging:
        stage = "merged"

    # Determine exit stage (needs-human, needs-info, rejected)
    exit_stage = None
    if stage in DONE and stage != "merged":
        exit_stage = stage
    elif stage in WAITING:
        exit_stage = stage

    # For exit stages, infer how far the job got from files on disk
    if exit_stage:
        effective_last = _last_pipeline_stage(job_dir, job)
    else:
        effective_last = stage  # stage is in PIPELINE (or "merged")

    timeline = []
    for ps in PIPELINE:
        # Compute "at" for this pipeline stage
        at = None
        sf = _STAGE_FILE.get(ps)
        if sf:
            at = _iso_mtime(job_dir / sf)
        elif ps == "review":
            files = _review_files(job_dir)
            at = _iso_mtime(files[0]) if files else None
        if merging and ps == "merged":
            at = None

        if exit_stage:
            # Stages up to and including effective_last are done;
            # the rest are replaced by one exit entry.
            if _stage_before(ps, effective_last) or ps == effective_last:
                timeline.append({"stage": ps, "state": "done", "at": at})
            else:
                # First future stage: emit exit entry and stop
                exit_at = _iso_mtime(_exit_file(job_dir, exit_stage))
                timeline.append({"stage": exit_stage, "state": "exit", "at": exit_at})
                break
        else:
            if ps == stage:
                timeline.append({"stage": ps, "state": "current", "at": at})
            elif _stage_before(ps, stage):
                timeline.append({"stage": ps, "state": "done", "at": at})
            else:
                timeline.append({"stage": ps, "state": "todo", "at": None})

    # If exit stage and all pipeline stages were done (e.g. rejected after approve)
    if exit_stage and not any(t["state"] == "exit" for t in timeline):
        exit_at = _iso_mtime(_exit_file(job_dir, exit_stage))
        timeline.append({"stage": exit_stage, "state": "exit", "at": exit_at})

    return timeline


def _exit_file(job_dir: Path, exit_stage: str) -> Path:
    """Return the file whose mtime represents the exit stage."""
    if exit_stage == "rejected":
        return job_dir / "rejection.md"
    if exit_stage == "needs-human":
        return job_dir / "decision.md"
    if exit_stage == "needs-info":
        return job_dir / "intake.md"
    return job_dir / "decision.md"


def _stage_before(a: str, b: str) -> bool:
    """Return True if pipeline stage a comes strictly before b."""
    if a not in PIPELINE or b not in PIPELINE:
        return False
    return PIPELINE.index(a) < PIPELINE.index(b)


def read_job(path: Path) -> dict:
    """Read a single job folder and return a view dict."""
    path = Path(path)
    job_json = path / "job.json"
    try:
        job = json.loads(job_json.read_text())
        if not isinstance(job, dict):
            raise ValueError("job.json is not an object")
    except Exception as exc:
        return {"id": path.name, "error": str(exc), **_empty_view(path.name)}

    stage = job.get("stage", "intake")

    # needs / note
    needs = None
    note = None
    if stage == "needs-human":
        needs = "you"
        note = _body(path / "decision.md")
    elif stage == "needs-info":
        needs = "author"
        note = _body(path / "intake.md")
    elif stage == "rejected":
        note = _body(path / "rejection.md")

    rounds = _build_rounds(path, job)
    timeline = _build_timeline(path, job)

    return {
        "id": job.get("id"),
        "issue": job.get("issue"),
        "title": job.get("title"),
        "issue_url": job.get("issue_url"),
        "pr": job.get("pr"),
        "pr_url": job.get("pr_url"),
        "stage": stage,
        "round": job.get("round", 0),
        "round_limit": job.get("round_limit", 3),
        "started": job.get("started"),
        "ended": job.get("ended"),
        "error": None,
        "needs": needs,
        "note": note,
        "required": job.get("reviewers", []),
        "rounds": rounds,
        "timeline": timeline,
    }


def _empty_view(job_id: str) -> dict:
    """Minimal view dict for an unreadable job (error case)."""
    return {
        "issue": None, "title": None, "issue_url": None,
        "pr": None, "pr_url": None, "stage": None,
        "round": None, "round_limit": None,
        "started": None, "ended": None,
        "needs": None, "note": None,
        "required": [], "rounds": [], "timeline": [],
    }


def read_jobs(jobs_dir: Path) -> list[dict]:
    """Read all job folders in jobs_dir, sorted by id. Returns [] if dir missing."""
    jobs_dir = Path(jobs_dir)
    if not jobs_dir.exists():
        return []
    folders = sorted(
        (p for p in jobs_dir.iterdir() if (p / "job.json").exists()),
        key=lambda p: p.name,
    )
    return [read_job(p) for p in folders]


_ERROR_DICT = {"ok": False, "checks": [], "passed": 0, "total": 0}


def pr_checks(pr: int | None, run=subprocess.run) -> dict | None:
    """Return CI check results for a PR number, or None if pr is None."""
    if pr is None:
        return None
    cmd = ["gh", "pr", "checks", str(pr), "--json", "name,bucket,link"]
    try:
        result = run(cmd, capture_output=True, text=True, timeout=20, cwd=REPO)
        if result.stdout.strip():
            data = json.loads(result.stdout)
        elif result.returncode == 1 and re.fullmatch(
            r"no checks reported on the '.+' branch", result.stderr.strip()
        ):
            data = []
        else:
            return dict(_ERROR_DICT)
    except (FileNotFoundError, OSError, subprocess.TimeoutExpired,
            json.JSONDecodeError):
        return dict(_ERROR_DICT)
    if not isinstance(data, list):
        return dict(_ERROR_DICT)
    checks = [{"name": c.get("name", ""), "bucket": c.get("bucket", ""),
               "link": c.get("link", "")} for c in data if isinstance(c, dict)]
    non_skip = [c for c in checks if c["bucket"] != "skipping"]
    passed = sum(1 for c in non_skip if c["bucket"] == "pass")
    return {
        "ok": True,
        "checks": checks,
        "passed": passed,
        "total": len(non_skip),
    }


# ---------------------------------------------------------------------------
# HTML render
# ---------------------------------------------------------------------------


def _safe_href(url: str | None) -> str | None:
    """Return url only if it starts with http(s), else None."""
    if url and re.match(r"^https?://", url):
        return _html.escape(url, quote=True)
    return None


def _fmt_elapsed(started: str | None, ended: str | None, now: str) -> str:
    """Format elapsed time matching bin/job took(): '{m}m' under 1 hour, else '{h}h{mm}m'."""
    if not started:
        return ""
    try:
        fmt = "%Y-%m-%dT%H:%M:%SZ"
        t0 = datetime.strptime(started, fmt).replace(tzinfo=timezone.utc)
        t1_str = ended or now
        t1 = datetime.strptime(t1_str, fmt).replace(tzinfo=timezone.utc)
        secs = int((t1 - t0).total_seconds())
        if secs < 0:
            secs = 0
        total_m = secs // 60
        h, m = divmod(total_m, 60)
        if h:
            return f"{h}h{m:02d}m"
        return f"{total_m}m"
    except Exception:
        return ""


